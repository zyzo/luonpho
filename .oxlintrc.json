{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", ".agents/**", ".claude/**"],
  "env": {
    "browser": true
  },
  "overrides": [
    {
      "files": [
        "tests/**/*.ts",
        "vite.config.ts",
        "services/chucongan/**/*.ts"
      ],
      "env": {
        "node": true
      }
    }
  ]
}
