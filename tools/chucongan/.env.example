# Choose a Responses API model supporting function calling and Structured Outputs.
OPENAI_API_KEY=replace-me
OPENAI_MODEL=replace-with-your-model-id

# GitHub App (required for webhook server; optional for CLI).
GITHUB_APP_ID=12345
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/chucongan.private-key.pem
GITHUB_INSTALLATION_ID=12345
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters
CHUCONGAN_BOT_LOGIN='chucongan[bot]'

CHUCONGAN_REPOSITORY=zyzo/luonpho
CHUCONGAN_STATE_DIR=.chucongan
CHUCONGAN_DAILY_LIMIT=50
HOST=127.0.0.1
PORT=8787

# CLI alternative: omit GITHUB_APP_ID and use GITHUB_TOKEN or existing gh auth.
# GITHUB_TOKEN=replace-me
